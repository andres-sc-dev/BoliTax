{
  "expo": {
    "name": "bolitax",
    "slug": "bolitax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.andressc.bolitax",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.3.21"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "BoliTax necesita acceder a tus fotos para subir tus documentos y las fotos de tu vehículo.",
          "cameraPermission": "BoliTax necesita acceder a la cámara para tomar las fotos de tus documentos y de tu vehículo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BoliTax usa tu ubicación para mostrarte en el mapa y enviarla a los pasajeros mientras estás Disponible."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/new_request.mp3"
          ],
          "defaultChannel": "trip_requests"
        }
      ],
      "expo-asset"
    ]
  }
}
