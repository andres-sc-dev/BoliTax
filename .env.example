# copia este archivo como .env y completa tus propios valores de prueba
# nunca subas el archivo .env real

# ---------- variables de la app (van dentro de la app, nunca pongas secretos aqui) ----------
# cloudinary (subidas sin firma para fotos de perfil, vehiculo y documentos)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# url del backend que crea las preferencias de pago
EXPO_PUBLIC_BACKEND_URL=

# ---------- solo backend (cloud functions), nunca accesibles desde la app ----------
# token de acceso de prueba de mercado pago
MERCADOPAGO_ACCESS_TOKEN=