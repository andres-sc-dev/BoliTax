# copia este archivo como .env (nunca subas el .env real)

# puerto del servidor Express
PORT=3000

# ruta a la llave de servicio de Firebase (descargada desde la consola, nunca se sube a Git)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Wompi (Sandbox). Llaves de prueba del panel de comercios de Wompi: nunca van en la app ni en Git
# llave publica (pub_test_...): va en la URL del Web Checkout
WOMPI_PUBLIC_KEY=
# llave privada (prv_test_...): solo para consultar transacciones desde el backend
WOMPI_PRIVATE_KEY=
# secreto de integridad (test_integrity_...): para firmar cada cobro
WOMPI_INTEGRITY_SECRET=
# URL de la API de Wompi (sandbox: https://sandbox.wompi.co/v1)
WOMPI_API_URL=
