{
  "name": "bolitax-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend de BoliTax: API (Express) y simulador de pasajeros",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=./src --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/server.js",
    "start": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/server.js",
    "simulate": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/simulatePassenger.js",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0"
  }
}
